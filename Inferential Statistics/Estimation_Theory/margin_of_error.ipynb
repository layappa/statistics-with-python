   "source": [
    "import numpy as np\n",
    "from scipy import stats\n",
    "\n",
    "data = [10, 12, 14, 15, 13]\n",
    "mean = np.mean(data)\n",
    "std = np.std(data, ddof=1)\n",
    "n = len(data)\n",
    "\n",
    "confidence_level = 0.95\n",
    "z = stats.norm.ppf((1 + confidence_level) / 2)\n",
    "\n",
    "margin_error = z * (std / np.sqrt(n))\n",
    "margin_error"
   ]
  }
 ],
